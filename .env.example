# OpenAI-compatible inference endpoint
# Default: KISSKI/SAIA (AcademicCloud) — https://docs.hpc.gwdg.de/services/ai-services/saia/
# Other options: OpenAI (https://api.openai.com/v1), local Ollama (http://localhost:11434/v1), etc.
LLM_BASE_URL=https://chat-ai.academiccloud.de/v1

# API key for the endpoint above
# SAIA key: https://kisski.gwdg.de/leistungen/2-02-llm-service/
LLM_API_KEY=your-api-key-here

# Model name as listed by the endpoint's /models API
# SAIA examples:  llama-3.3-70b-instruct | mistral-large-3-675b-instruct-2512
# OpenAI examples: gpt-4o | gpt-4o-mini
LLM_MODEL=llama-3.3-70b-instruct
